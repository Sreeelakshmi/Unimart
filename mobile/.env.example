# ============================================================
# Mobile environment variables — Campus Marketplace
# EXPO_PUBLIC_* variables are bundled into the app.
# NEVER put secret keys here — only publishable/public values.
# ============================================================

# Base URL of the Express API
# - For physical phone testing on same Wi-Fi, use computer's LAN IP (e.g. http://192.168.1.26:4000/api)
# - For Android emulator on development machine, use http://10.0.2.2:4000/api
# - For production / cloud deployment, use your HTTPS server URL
EXPO_PUBLIC_API_URL=http://192.168.1.26:4000/api

# Realistic Campus Marketplace Demo Mock Mode (set to 'true' for standalone offline/demo testing)
EXPO_PUBLIC_USE_MOCK_DATA=true

# Clerk publishable key (safe to include in mobile, obtain from https://dashboard.clerk.com/)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
